{
  "keyCommand": "security find-generic-password -a typesafe/api-key -s kern -w",
  "timeoutMs": 12000,
  "hazards": "unverified_claim, placeholder_left, unaddressed_part, silent_failure",
  "specMet": 0.8,
  "minCoverage": 0.6,
  "minCoverageConfidence": 0.7,
  "minActionProbability": 0.5,
  "checks": {
    "tests": {
      "command": "bun test 2>&1 | tail -5"
    },
    "build": {
      "command": "git ls-files 'src/*.ts' 'adapters/*.ts' 'bin/*.ts' | while read f; do bun build \"$f\" --target=bun --outfile=/dev/null >/dev/null || exit 1; done"
    },
    "readme_lines": {
      "command": "cat README.md",
      "countPattern": "\\n"
    },
    "net_in_tests": {
      "command": "cat test/*.test.ts",
      "countPattern": "fetch\\("
    },
    "todos_in_src": {
      "command": "cat src/*.ts adapters/*.ts bin/*.ts",
      "countPattern": "//\\s*(TODO|FIXME|XXX)"
    },
    "unlabelled_fixtures": {
      "command": "for f in test/fixtures/*.jsonl; do n=$(basename $f .jsonl); grep -q \"$n\" test/calibrate.ts || echo \"UNLABELLED $n\"; done",
      "countPattern": "UNLABELLED"
    },
    "git_dirty": {
      "command": "git status --porcelain",
      "countPattern": "\\n"
    },
    "missing_docs": {
      "command": "grep -o 'docs/[a-z-]*\\.txt' llms.txt | sort -u | while read d; do [ -f \"$d\" ] || echo \"MISSING $d\"; done",
      "countPattern": "MISSING"
    },
    "unfitted_specs": {
      "command": "jq -r '.specs[] | select(has(\"require\")|not) | select(has(\"fitted\")|not) | .id' .orly/specs.json",
      "countPattern": "\\n"
    }
  }
}
