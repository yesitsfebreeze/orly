{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code.ts\"",
            "timeout": 25,
            "statusMessage": "orly? checking the goal specs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code-session.ts\"",
            "timeout": 10,
            "statusMessage": "orly? loading the gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code-guard.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}